{
  "about": "Hand-built trajectories over the fixture world (tests/fixtures/pokeapi_mini, scope alpha-beta and gamma, Sprig's alpha-beta level-up learnset withheld). Every expected label is written by hand from the rendered units, never computed. Species: 1 Sprig -> 2 Sprout -> 3 Sproutree; 4 Blaze. Moves: 1 Vine Lash (Moss), 2 Cinder (Ember). Types: 1 Ember, 2 Tide, 3 Moss. Abilities: 3 Undertow.",
  "cases": [
    {
      "name": "S0: the hidden ability is found on the second step",
      "question": {"id": "S0-A1:x=1", "stratum": "S0", "gold_facts": ["pability:1:3:hidden"]},
      "steps": [["move/1/profile", "move/2/profile"], ["species/1/profile"]],
      "expected": [
        {"state": "insufficient", "subtype": "missing-hop", "missing": ["pability:1:3:hidden"]},
        {"state": "insufficient", "subtype": "missing-hop", "missing": ["pability:1:3:hidden"]},
        {"state": "sufficient", "subtype": null, "missing": []}
      ]
    },
    {
      "name": "S0: either copy of a fact suffices (the ability's holders list)",
      "question": {"id": "S0-A1:x=1", "stratum": "S0", "gold_facts": ["pability:1:3:hidden"]},
      "steps": [["ability/3/holders/0"]],
      "expected": [
        {"state": "insufficient", "subtype": "missing-hop", "missing": ["pability:1:3:hidden"]},
        {"state": "sufficient", "subtype": null, "missing": []}
      ]
    },
    {
      "name": "S0: an empty step and a repeated unit change nothing",
      "question": {"id": "S0-A2:m=1", "stratum": "S0", "gold_facts": ["mpower:1:45"]},
      "steps": [[], ["move/1/profile"], ["move/1/profile"], []],
      "expected": [
        {"state": "insufficient", "subtype": "missing-hop", "missing": ["mpower:1:45"]},
        {"state": "insufficient", "subtype": "missing-hop", "missing": ["mpower:1:45"]},
        {"state": "sufficient", "subtype": null, "missing": []},
        {"state": "sufficient", "subtype": null, "missing": []},
        {"state": "sufficient", "subtype": null, "missing": []}
      ]
    },
    {
      "name": "S1: the final form's hidden ability is seen before the line is known to end",
      "note": "After step 2 the agent has seen that Sproutree's hidden ability is Undertow, the right answer, but not that Sproutree is the final form: a correct answer here is a lucky stop.",
      "question": {"id": "S1-A1:x=1", "stratum": "S1", "gold_facts": ["evo:2:1", "evo:3:2", "evoend:3", "pability:3:3:hidden"]},
      "steps": [["species/1/profile"], ["ability/3/holders/0"], ["species/2/profile"], ["species/3/profile"]],
      "expected": [
        {"state": "insufficient", "subtype": "missing-hop", "missing": ["evo:2:1", "evo:3:2", "evoend:3", "pability:3:3:hidden"]},
        {"state": "insufficient", "subtype": "missing-hop", "missing": ["evo:3:2", "evoend:3", "pability:3:3:hidden"]},
        {"state": "insufficient", "subtype": "missing-hop", "missing": ["evo:3:2", "evoend:3"]},
        {"state": "insufficient", "subtype": "missing-hop", "missing": ["evoend:3"]},
        {"state": "sufficient", "subtype": null, "missing": []}
      ]
    },
    {
      "name": "S1: a move hub states the defender's type",
      "question": {"id": "S1-B1:m=1,x=4", "stratum": "S1", "gold_facts": ["mtype:1:3", "ptype:4:1:1", "eff:3:1:50"]},
      "steps": [["move/1/profile"], ["move/2/learned-by/gamma/0"], ["type/3/matchups"]],
      "expected": [
        {"state": "insufficient", "subtype": "missing-hop", "missing": ["mtype:1:3", "ptype:4:1:1", "eff:3:1:50"]},
        {"state": "insufficient", "subtype": "missing-hop", "missing": ["ptype:4:1:1", "eff:3:1:50"]},
        {"state": "insufficient", "subtype": "missing-hop", "missing": ["eff:3:1:50"]},
        {"state": "sufficient", "subtype": null, "missing": []}
      ]
    },
    {
      "name": "S2: the other version's learnset is seen first",
      "question": {"id": "S2-A1:p=4,m=2,v=gamma", "stratum": "S2", "gold_facts": ["learn:4:2:gamma:level-up:7"], "distractor_facts": ["learn:4:2:alpha-beta:level-up:1"]},
      "steps": [["species/4/profile"], ["species/4/learnset/level-up/alpha-beta/0"], ["move/2/learned-by/gamma/0"]],
      "expected": [
        {"state": "insufficient", "subtype": "wrong-version", "missing": ["learn:4:2:gamma:level-up:7"], "near_certain": []},
        {"state": "insufficient", "subtype": "wrong-version", "missing": ["learn:4:2:gamma:level-up:7"], "near_certain": []},
        {"state": "insufficient", "subtype": "wrong-version", "missing": ["learn:4:2:gamma:level-up:7"], "near_certain": ["species/4/learnset/level-up/alpha-beta/0"]},
        {"state": "sufficient", "subtype": null, "missing": [], "near_certain": ["species/4/learnset/level-up/alpha-beta/0"]}
      ]
    },
    {
      "name": "S3: the set arrives one member at a time",
      "note": "The generator would drop this set (size 2, and one hub holds it all); the labeler does not filter.",
      "question": {"id": "S3-A1:m=1,v=alpha-beta,t=3", "stratum": "S3", "gold_facts": ["learn:2:1:alpha-beta:level-up:1", "ptype:2:1:3", "learn:3:1:alpha-beta:level-up:0", "ptype:3:1:3"]},
      "steps": [["species/2/learnset/level-up/alpha-beta/0", "species/2/profile"], ["species/3/learnset/level-up/alpha-beta/0"], ["species/3/profile"]],
      "expected": [
        {"state": "insufficient", "subtype": "truncated", "missing": ["learn:2:1:alpha-beta:level-up:1", "ptype:2:1:3", "learn:3:1:alpha-beta:level-up:0", "ptype:3:1:3"], "members": [0, 2]},
        {"state": "insufficient", "subtype": "truncated", "missing": ["learn:3:1:alpha-beta:level-up:0", "ptype:3:1:3"], "members": [1, 2]},
        {"state": "insufficient", "subtype": "truncated", "missing": ["ptype:3:1:3"], "members": [1, 2]},
        {"state": "sufficient", "subtype": null, "missing": [], "members": [2, 2]}
      ]
    },
    {
      "name": "S3: the move's hub holds every member and its type",
      "question": {"id": "S3-A1:m=1,v=alpha-beta,t=3", "stratum": "S3", "gold_facts": ["learn:2:1:alpha-beta:level-up:1", "ptype:2:1:3", "learn:3:1:alpha-beta:level-up:0", "ptype:3:1:3"]},
      "steps": [["move/1/learned-by/alpha-beta/0"]],
      "expected": [
        {"state": "insufficient", "subtype": "truncated", "missing": ["learn:2:1:alpha-beta:level-up:1", "ptype:2:1:3", "learn:3:1:alpha-beta:level-up:0", "ptype:3:1:3"], "members": [0, 2]},
        {"state": "sufficient", "subtype": null, "missing": [], "members": [2, 2]}
      ]
    },
    {
      "name": "S4: never sufficient, however much is seen",
      "note": "The alpha-beta hub of Vine Lash does not list Sprig: withheld pairs are removed from hubs too.",
      "question": {"id": "S4-A1:p=1,m=1,v=alpha-beta", "stratum": "S4", "gold_facts": ["learn:1:1:alpha-beta:level-up:1"], "distractor_facts": ["learn:1:1:gamma:level-up:5"]},
      "steps": [["species/1/profile"], ["species/1/learnset/level-up/gamma/0"], ["move/1/learned-by/alpha-beta/0"], ["move/1/learned-by/gamma/0"]],
      "expected": [
        {"state": "insufficient", "subtype": "nonexistent", "missing": ["learn:1:1:alpha-beta:level-up:1"], "near_certain": []},
        {"state": "insufficient", "subtype": "nonexistent", "missing": ["learn:1:1:alpha-beta:level-up:1"], "near_certain": []},
        {"state": "insufficient", "subtype": "nonexistent", "missing": ["learn:1:1:alpha-beta:level-up:1"], "near_certain": ["species/1/learnset/level-up/gamma/0"]},
        {"state": "insufficient", "subtype": "nonexistent", "missing": ["learn:1:1:alpha-beta:level-up:1"], "near_certain": ["species/1/learnset/level-up/gamma/0"]},
        {"state": "insufficient", "subtype": "nonexistent", "missing": ["learn:1:1:alpha-beta:level-up:1"], "near_certain": ["move/1/learned-by/gamma/0", "species/1/learnset/level-up/gamma/0"]}
      ]
    }
  ],
  "refused": [
    {
      "name": "a withheld unit can never be seen",
