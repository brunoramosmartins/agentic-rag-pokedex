# Copy to .env (gitignored) and fill in.

# Neo4j — the examiner (docker compose)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please

# Phoenix — OTel collector (docker compose)
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# LLM provider (registered runs use the Batch API)
OPENAI_API_KEY=
